# ─────────────────────────────────────────────────────────────────────────────
# SaaS Starter — environment variables
#
# Copy this file to `.env` (or `.env.local`) and fill in the values:
#   cp .env.example .env
#
# The app runs out of the box with just JWT_SECRET set. Email and Stripe are
# optional — without their keys, billing buttons are disabled and emails are
# printed to the server console instead of being sent.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite file path. Defaults to ./local.db if unset. Tables are created
# automatically on first run (or via `npm run db:migrate`).
# In Docker, point this at a mounted volume, e.g. /data/saas.db
DB_PATH=./local.db

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED. Secret used to sign session JWTs. Must be long and random.
# The app refuses to start in production if this is unset.
# Generate one with:
#   openssl rand -base64 32
JWT_SECRET=replace-me-with-a-32-byte-random-string

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of the app. Used for email links and Stripe redirect URLs.
# No trailing slash. e.g. https://app.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Display name used in emails and UI copy.
APP_NAME=SaaS Starter

# ── Email (optional — Resend) ────────────────────────────────────────────────
# Transactional email for verification, password reset, and invitations.
# Without a key, emails are logged to the server console (fine for local dev).
# Get a key: https://resend.com/api-keys
RESEND_API_KEY=

# "From" address for outgoing email. Must be a domain you've verified in Resend.
# https://resend.com/domains
EMAIL_FROM=noreply@yourdomain.com

# ── Stripe (optional — billing) ──────────────────────────────────────────────
# Without these, the billing UI shows but checkout is disabled.
# Dashboard: https://dashboard.stripe.com/apikeys  (use test keys to start)
STRIPE_SECRET_KEY=

# Webhook signing secret, used to verify incoming Stripe events.
# Create an endpoint at https://dashboard.stripe.com/webhooks pointing to
#   {NEXT_PUBLIC_APP_URL}/api/stripe/webhook
# then copy the "Signing secret" (starts with whsec_).
# For local testing: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=

# Price IDs for the paid plans. Create products + recurring prices at
# https://dashboard.stripe.com/products and copy each price ID (starts with price_).
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# Optional: publishable key, only needed if you add client-side Stripe.js.
# https://dashboard.stripe.com/apikeys  (starts with pk_)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
